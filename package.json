{
  "name": "quill-variable-kit",
  "version": "0.3.0",
  "description": "A tiny framework-agnostic Quill 2 editor with variables, single-line mode and char limit.",
  "keywords": [
    "quill",
    "rich-text-editor",
    "rich text",
    "wysiwyg",
    "variables",
    "character-limit",
    "single-line",
    "framework-agnostic",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/travelfitdev/quill-variable-kit.git"
  },
  "author": "travelfitdev <lantian.kobe@gmail.com>",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "style.css",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && pnpm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:webpack4": "vitest run tests/webpack4-smoke.test.ts",
    "example:dev": "vite --config examples/vite.config.ts --host 0.0.0.0",
    "example:build": "vite build --config examples/vite.config.ts",
    "pack:check": "pnpm pack --dry-run",
    "prepare": "husky",
    "prepublishOnly": "pnpm run verify",
    "preversion": "pnpm run verify",
    "postversion": "git push && git push --tags",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "verify": "pnpm run format:check && pnpm run lint && pnpm run check && pnpm run test && pnpm run build && pnpm run test:webpack4 && pnpm run example:build && pnpm run pack:check"
  },
  "peerDependencies": {
    "quill": "^2.0.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.10.5",
    "@types/webpack": "^4.41.40",
    "@vitejs/plugin-vue": "^5.2.1",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "prettier": "^3.9.8",
    "quill": "^2.0.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "vue": "^3.5.13",
    "webpack": "^4.47.0"
  },
  "engines": {
    "node": ">=20"
  }
}
